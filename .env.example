# API del WordPress (plugin Etchegaray Catálogo). Se usa al compilar y en los formularios.
WP_API=https://etchegarayautos.cl/admin/wp-json/etchegaray/v1
PUBLIC_WP_API=https://etchegarayautos.cl/admin/wp-json/etchegaray/v1
# Dominio público del sitio
SITE_URL=https://etchegarayautos.cl
# Si el catálogo de WordPress está vacío, mostrar vehículos de ejemplo (true/false)
USAR_DEMO_SI_VACIO=true
