---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getAjustes } from '../lib/api';
const a = await getAjustes();
const pasos = [['Cuéntanos de tu auto', 'Completa el formulario con marca, modelo, año y kilometraje.'], ['Te contactamos', 'Un ejecutivo te llama o escribe para coordinar una revisión.'], ['Definimos el camino', 'Vender, consignar o usarlo como parte de pago de tu próximo auto.']];
---
<Base titulo="Vende o consigna tu auto en Temuco" descripcion="Vende tu auto en Temuco o consígnalo con Etchegaray Autos. Cuéntanos los datos de tu vehículo y te contactamos.">
  <PageHead titulo="Vende tu auto" texto="Podemos venderlo por ti o recibirlo como parte de pago de tu próximo vehículo." />
  <section class="seccion" id="como"><div class="wrap dos" style="align-items:start">
    <div>
      <span class="kicker">Cómo funciona</span><h2>Tres pasos simples</h2>
      <ol class="lista-ok" style="counter-reset:p">{pasos.map(([t, d]) => <li><strong>{t}.</strong> {d}</li>)}</ol>
      <ul class="lista-ok"><li>Atención personalizada en nuestro local de Temuco</li><li>Sin compromiso: tú decides</li></ul>
    </div>
    <div class="caja"><h2 style="font-size:1.8rem">Datos de tu vehículo</h2><QuoteForm tipo="consignacion" id="vende" boton="Enviar datos de mi auto" turnstile={a.turnstile_site_key} mensajePlaceholder="Estado, mantenciones, valor que esperas…" /></div>
  </div></section>
</Base>
