---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getAjustes } from '../lib/api';
const a = await getAjustes();
---
<Base titulo="Financiamiento de autos en Temuco" descripcion="Te evaluamos y buscamos la mejor alternativa de financiamiento para tu próximo auto, con distintas financieras, en Etchegaray Autos Temuco.">
  <PageHead titulo="Financiamiento" texto="Te evaluamos y buscamos la alternativa que mejor se adapte a ti." />
  <section class="seccion"><div class="wrap dos" style="align-items:start">
    <div>
      <span class="kicker">Cómo funciona</span>
      <h2>Financia tu próximo vehículo</h2>
      <p class="lead">Trabajamos con distintas financieras para revisar opciones de financiamiento según tu perfil y tus necesidades.</p>
      <ul class="lista-ok"><li>Evaluamos tu caso y buscamos la mejor alternativa</li><li>Comparamos opciones entre distintas financieras</li><li>También puedes considerar tu auto actual como parte de pago</li><li>Evaluación sujeta a aprobación de la financiera</li></ul>
    </div>
    <div class="caja" id="cotiza"><h3>Cotiza con financiamiento</h3><QuoteForm tipo="cotizacion" id="fin-form" boton="Quiero que me contacten" turnstile={a.turnstile_site_key} /></div>
  </div></section>
</Base>
