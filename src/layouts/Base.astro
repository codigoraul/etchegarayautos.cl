---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { getAjustes, getVehiculos } from '../lib/api';
import { waLink } from '../lib/format';

interface Props { titulo?: string; tituloSeo?: string; descripcion?: string; imagen?: string; jsonld?: object | object[]; noindex?: boolean }
const { titulo, tituloSeo, descripcion = 'Autos seminuevos y usados en Temuco. Vehículos seleccionados, información clara y atención personalizada.', imagen, jsonld, noindex } = Astro.props;
const a = await getAjustes();
const { demo } = await getVehiculos();
const full = tituloSeo ? tituloSeo : titulo ? `${titulo} | Etchegaray Autos` : 'Etchegaray Autos | Autos seminuevos y usados en Temuco';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(imagen || '/img/logo.png', Astro.site).href;
const wa = waLink(a, 'Hola, quiero consultar por un vehículo.');
const negocio = {
  '@context': 'https://schema.org', '@type': 'AutoDealer', name: 'Etchegaray Autos', url: Astro.site?.href,
  image: new URL('/img/logo.png', Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: 'Blanco Encalada 985', addressLocality: 'Temuco', addressCountry: 'CL' },
  ...(a.telefono ? { telephone: a.telefono } : {}),
};
const bloques = [negocio, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  {(noindex || demo) && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#D90000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" /><meta property="og:locale" content="es_CL" />
  <meta property="og:title" content={full} /><meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonical} /><meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  {bloques.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  {demo && <div class="aviso-demo">Vista previa con vehículos de ejemplo. Los reales se cargan desde WordPress.</div>}
  <Header a={a} />
  <main id="contenido"><slot /></main>
  <Footer a={a} />
  {wa && <a class="wa-fab" href={wa} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><WhatsAppIcon /></a>}
</body>
</html>
