---
import { clp, km, precioFinal, enOferta, foto, u } from '../lib/format';
import type { Vehiculo } from '../lib/api';
const { v, filtro = false, prioridad = false } = Astro.props as { v: Vehiculo; filtro?: boolean; prioridad?: boolean };
const f = v.portada || v.galeria?.[0];
const nombre = [v.marca?.nombre, v.modelo, v.version].filter(Boolean).join(' ') || v.titulo;
const attrs = filtro ? {
  'data-marca': v.marca?.nombre ?? '', 'data-tipo': v.carroceria, 'data-cond': v.condicion, 'data-anio': v.anio,
  'data-precio': precioFinal(v), 'data-km': v.kilometraje, 'data-trans': v.transmision, 'data-comb': v.combustible,
  'data-dest': v.destacado ? 1 : 0, 'data-id': v.id,
  'data-q': `${v.titulo} ${v.marca?.nombre ?? ''} ${v.modelo} ${v.version} ${v.carroceria} ${v.color}`.toLowerCase(),
} : {};
---
<article class="card" {...attrs}>
  <div class="foto">
    <img src={foto(f, 'medium')} alt={f?.alt || v.titulo} width={f?.width ? 640 : undefined} height={f?.width ? Math.round(640 * (f.height! / f.width!)) : undefined} loading={prioridad ? 'eager' : 'lazy'} decoding="async" />
    <div class="etiquetas">
      <span class="tag">{v.condicion}</span>
      {enOferta(v) && <span class="tag oferta">Oferta</span>}
      {v.estado_venta === 'Reservado' && <span class="tag reservado">Reservado</span>}
      {v.demo && <span class="tag demo">Ejemplo</span>}
    </div>
  </div>
  <div class="cuerpo">
    <h3><a href={u(`/autos/${v.slug}/`)}>{nombre}</a></h3>
    <div class="precio-fila">
      <span class="precio">{clp(precioFinal(v))}</span>
      {enOferta(v) && <span class="precio-ant">{clp(v.precio)}</span>}
    </div>
    <ul class="specs">
      <li>{v.anio}</li><li>{km(v.kilometraje)}</li><li>{v.transmision}</li><li>{v.combustible}</li>
    </ul>
  </div>
</article>
